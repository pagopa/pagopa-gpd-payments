            "example" : "2026/08/31/10/message-1/MAX_RETRY_ATTEMPTS_REACHED_1000.json"
          },
          "messageId" : {
            "type" : "string",
            "description" : "Original Azure Queue message identifier.",
            "example" : "message-1"
          },
          "dequeueCount" : {
            "type" : "integer",
            "description" : "Number of times the message was dequeued before being moved to dead-letter storage.",
