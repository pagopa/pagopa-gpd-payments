<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProfile name="!default">
        <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
        <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
        <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

        <appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
            <layout class="ch.qos.logback.classic.PatternLayout">
                <Pattern>
                    %clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m %clr(%mdc){magenta}%n%wEx
                </Pattern>
            </layout>
        </appender>

        <root level="INFO">
            <appender-ref ref="stdout"/>
        </root>
    </springProfile>
    <springProfile name="default">
        <springProperty name="APPLICATION_NAME" source="info.application.name" defaultValue="pagopa-gpd-payments"/>
        <springProperty name="APPLICATION_ENVIRONMENT" source="info.properties.environment"/>
        <springProperty name="ECS_SERVICE_NAME" source="SERVICE_NAME" defaultValue="${APPLICATION_NAME}"/>
        <springProperty name="ECS_SERVICE_VERSION" source="info.application.version"/>
        <springProperty name="ECS_SERVICE_ENVIRONMENT" source="ENV" defaultValue="${APPLICATION_ENVIRONMENT}"/>
        <appender name="ECS_JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="it.gov.pagopa.payments.config.JsonLogEncoder">
                <serviceName>${ECS_SERVICE_NAME}</serviceName>
                <serviceVersion>${ECS_SERVICE_VERSION}</serviceVersion>
                <serviceEnvironment>${ECS_SERVICE_ENVIRONMENT}</serviceEnvironment>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="ECS_JSON_CONSOLE"/>
        </root>
    </springProfile>
</configuration>
